<?xml version="1.0" encoding="UTF-8"?>
<!--
Baseline Technical Smoke Test, Synthetic Demand.
NOT a validated traffic model. See simulation/routes/README.md.
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="../network/mvogmbi_postecentrale_corridor.net.xml"/>
        <route-files value="../routes/synthetic_smoke_test.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="1800"/>
    </time>

    <output>
        <tripinfo-output value="../../data/processed/baseline_smoke_test_tripinfo.xml"/>
        <summary-output value="../../data/processed/baseline_smoke_test_summary.xml"/>
    </output>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

</configuration>
